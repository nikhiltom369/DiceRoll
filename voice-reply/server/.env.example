# Copy to .env and fill in. Never commit the real .env file.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# From clone_voice.py, or ElevenLabs website -> Voices -> your voice -> Copy voice ID
ELEVENLABS_VOICE_ID=
# Any long random password. Type the same value in the app's settings.
APP_TOKEN=

# Optional
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low
# STT_MODEL=scribe_v2
# TTS_MODEL=eleven_multilingual_v2
